API_BASE_URL=http://192.168.100.239:3000

# Google OAuth — from Google Cloud Console (OAuth 2.0 Client IDs)
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Dev only: override daily notification time (24h HH:mm). Rebuild app after changing.
DEV_NOTIFICATION_TIME=09:30

# Dev only: set to "true" to swap the Google Sign-In button for a mock sign-in
# button (server must have AUTH_MOCK_GOOGLE=true set). Restart with `expo start -c`
# after changing. Identity fields default to dev-1 / dev@example.com / Dev User.
AUTH_MOCK_LOGIN=true
AUTH_MOCK_EMAIL=dev@example.com
AUTH_MOCK_NAME=Dev User
AUTH_MOCK_GOOGLE_ID=dev-1
